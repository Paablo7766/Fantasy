# Copia este archivo a .env y rellena los valores. .env no se versiona.
# El access token caduca a las 24 h. toolbox/auth.py lo renueva con el refresh token.
# El refresh token caduca a los 90 días; pasado ese plazo hay que repetir el login PKCE.

# Bearer de LALIGA Fantasy (JWT). Sin el prefijo "Bearer ".
LALIGA_ACCESS_TOKEN=

# Refresh token de Azure B2C asociado a la cuenta de Google.
LALIGA_REFRESH_TOKEN=

# Liga sobre la que opera el agente. Vacío = la única liga de la cuenta.
# Si hay varias, market y squads se niegan a elegir solas y devuelven los ids.
LEAGUE_ID=

# --- Gatillo remoto (orquestador en el VPS) ---
# Contraseña simple del endpoint POST /api/remote/refresh, que se valida contra
# el header X-Remote-Token. Sin valor, el endpoint responde 503 y no arranca
# ninguna pasada. Genera uno con: python -c "import secrets;print(secrets.token_urlsafe(32))"
# REMOTE_REFRESH_TOKEN se acepta como alias por compatibilidad.
REMOTE_TRIGGER_TOKEN=
# Presupuesto por defecto (minutos) cuando el payload no manda target_minutes.
REMOTE_REFRESH_DEFAULT_MINUTES=60

# Entorno del motor de red. Solo el contenedor del VPS debe llevar
# `production` (docker-compose.yml lo inyecta). En tu PC déjalo vacío o en
# `development`: el air-gap impide que el dashboard abra sockets hacia LaLiga.
# LALIGA_ENV=development

# Autorización humana. La Fase 1 no envía mensajes; la gobernanza está en context/USER.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PostgreSQL vía Supabase. Obligatorio en producción (Render / backend remoto).
# Sin estas claves, toolbox/cache.py usa un almacén local compatible con las pruebas.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=

# Origen del frontend Next.js en producción (Vercel). En desarrollo se permite localhost.
# Los previews de Vercel (https://*.vercel.app) y los túneles de Cloudflare
# (https://*.trycloudflare.com) ya están en el regex de CORS de server.py.
FRONTEND_ORIGIN=https://fantasy-45mn.vercel.app
CORS_ORIGINS=

# --- Modo avión (desarrollo del frontend) ---
# Con FANTASY_OFFLINE=1 el backend no sale a la red: sirve solo lo que ya está
# en la caché de disco (.cache/scraper_bodies). Si una URL no tiene copia,
# responde 503 «Offline mode: caché no encontrada». ``fresh`` y el TTL se
# ignoran: siempre se sirve la última copia guardada.
# Cubre LALIGA, las fuentes de inteligencia, Playwright y la renovación del
# token. Actívalo antes de arrancar uvicorn (o escríbelo aquí, sin exportarlo).
# FANTASY_OFFLINE=1

# --- Motor de caja rival (rival-intel) ---
# Reglas financieras de la liga. Sin estas variables el motor usa los fallbacks
# marcados; un valor inválido también cae al fallback (una errata de .env no
# puede romper la cota de caja).
#
# Primer día de liga (YYYY-MM-DD). Base del devengo de los 100.000 €/día de
# publicidad: el motor abona un anuncio por cada día de liga transcurrido.
LEAGUE_START_DATE=2026-08-01
#
# Fracción del incremento que cuesta subir una cláusula. La app muestra 1:2
# (0,5); 0,20 es deliberadamente más barato para que la caja rival sea una
# cota superior. Rango válido: (0, 1].
CLAUSE_INCREASE_MULTIPLIER=0.20
#
# Multiplicador de la cláusula base de un jugador del reparto inicial
# (cláusula ≈ valor de mercado × este factor).
STARTING_CLAUSE_MULTIPLIER=1.5
#
# --- Termómetro de control (calibración de la cota) ---
# Hueco relativo con el que la temperatura del termómetro cae a 1/e. Más alto =
# más tolerante con la diferencia entre la cota calculada y la caja observada.
CASH_THERMOMETER_TAU=0.10
# Hueco relativo que se considera ruido de medición y no error de los libros.
CASH_ARBITRAGE_BAND=0.02
# Suelo (€) de la incertidumbre de caja que alimenta la barrera bayesiana.
CASH_UNCERTAINTY_FLOOR_EUR=150000

# --- Fuentes de inteligencia (trends) ---
# Sofascore: JSON de estadísticas de jugadores (LaLiga 25/26 ≈ 77559).
# SOFASCORE_SEASON_ID=77559
# SOFASCORE_STATS_URL=https://api.sofascore.com/api/v1/unique-tournament/8/season/77559/top-players/overall
#
# FBref / Sofascore / Cloudflare: con Playwright instalado, FANTASY_SCRAPER_BROWSER=1
# intenta HTML (FBref) o JSON (Sofascore) cuando httpx recibe 403.
# Desde tu PC: python cli.py warm-stats --json --fresh
# FANTASY_SCRAPER_BROWSER=0
#
# Transfermarkt: wrapper público (rate limit 2 req / 3 s). Alternativa si fly.dev cae:
# TRANSFERMARKT_API_BASE=https://transfermarkt-api.fly.dev
#
# Understat: temporada (año de inicio, p. ej. 2026 para 2026/27).
# UNDERSTAT_SEASON=2026
#
# Jornada Perfecta: mercado LaLiga con tips fantasy-native.
# JORNADA_PERFECTA_MARKET_URL=https://www.jornadaperfecta.com/mercado/?competition=laliga
#
# Cuotas pre-partido (The Odds API). Sin clave, el pipeline simula cuotas desde rolling xG.
# THE_ODDS_API_KEY=
# FANTASY_TTL_ODDS=21600
#
# TTL opcionales (segundos): FANTASY_TTL_STATS, FANTASY_TTL_FUTBOLFANTASY_MARKET, …

# --- Control de tráfico (anti-429) ---
# Un suelo duro entre dos GET al mismo dominio, compartido por todos los hilos
# del proceso: LaLiga 1,5 s (máx. 40/min) y FútbolFantasy 2 s (máx. 30/min).
# Es lo que evita el thundering herd del arranque en frío, cuando la caché está
# vacía y varios workers piden lo mismo a la vez. No lo apagues en producción;
# FANTASY_NET_PACING=0 existe para pruebas y para diagnosticar un 429.
# FANTASY_NET_PACING=1
