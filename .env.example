# Copia este archivo a .env y rellena los valores. .env no se versiona.
# El access token caduca a las 24 h. toolbox/auth.py lo renueva con el refresh token.
# El refresh token caduca a los 90 días; pasado ese plazo hay que repetir el login PKCE.

# Bearer de LALIGA Fantasy (JWT). Sin el prefijo "Bearer ".
LALIGA_ACCESS_TOKEN=

# Refresh token de Azure B2C asociado a la cuenta de Google.
LALIGA_REFRESH_TOKEN=

# Liga sobre la que opera el agente. Vacío = la única liga de la cuenta.
# Si hay varias, market y squads se niegan a elegir solas y devuelven los ids.
LEAGUE_ID=

# Autorización humana. La Fase 1 no envía mensajes; la gobernanza está en context/USER.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PostgreSQL vía Supabase. Obligatorio en producción (Vercel / backend remoto).
# Sin estas claves, toolbox/cache.py usa un almacén local compatible con las pruebas.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=

# Origen del frontend Next.js en producción. En desarrollo se permite localhost.
# Los previews de Vercel (https://*.vercel.app) ya están en el regex de CORS.
FRONTEND_ORIGIN=https://YOUR-APP.vercel.app
CORS_ORIGINS=
